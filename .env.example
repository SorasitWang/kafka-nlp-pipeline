KAFKA_BROKERS=localhost:9092
TOPIC_NAME=text-stream
# Consumers retry a failing message, then park it here and move on.
DLQ_TOPIC_NAME=text-stream.dlq
CONSUMER_MAX_ATTEMPTS=3
CONSUMER_RETRY_BACKOFF_SECONDS=1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=textanalysis
POSTGRES_USER=textanalysis
POSTGRES_PASSWORD=textanalysis

PRODUCER_DATA_FILE=../data/dataset.jsonl
PRODUCER_DELAY_MS=200
PRODUCER_LOOP=false

DASHBOARD_PORT=3000

VISUALIZER_PORT=3001
VISUALIZER_POLL_MS=2000

# scripts/start-all.sh only: per-consumer-process CPU thread cap (OMP/MKL),
# and how many topic_service instances to run (they share one Kafka consumer
# group, so Kafka splits the topic's partitions across however many run).
CONSUMER_THREADS=4
TOPIC_INSTANCES=1
